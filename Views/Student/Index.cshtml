@model List<wt_lab4_4mvc_liger.Models.Student>

@{
    ViewData["Title"] = "Список студентов";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Список студентов</h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Добавить студента
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Список студентов пуст. Добавьте первого студента.
        </div>
    }
    else
    {
        <p class="text-muted">Всего студентов: @Model.Count</p>

        <table class="table table-striped table-hover align-middle">
            <thead class="table-primary">
                <tr>
                    <th>ID</th>
                    <th>ФИО</th>
                    <th>Специальность</th>
                    <th>Курс</th>
                    <th>Средний балл</th>
                    <th>Зачислен</th>
                    <th class="text-end">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var student in Model)
                {
                    <tr>
                        <td>@student.Id</td>
                        <td>@student.FullName</td>
                        <td>@student.Faculty</td>
                        <td>@student.Course</td>
                        <td>@student.AverageGrade</td>
                        <td>
                            @if (student.IsEnrolled)
                            {
                                <span class="badge bg-success">Да</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Нет</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="Details"
                               asp-route-id="@student.Id"
                               class="btn btn-sm btn-outline-primary">
                                Подробнее
                            </a>

                            <form asp-action="Delete"
                                  asp-route-id="@student.Id"
                                  method="post"
                                  class="d-inline"
                                  onsubmit="return confirm('Удалить студента @student.FullName?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    Удалить
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>