@model wt_lab4_4mvc_liger.Models.Student

@{
    ViewData["Title"] = "Добавить студента";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">

            <div class="card shadow-sm rounded-4 border-0">
                <div class="card-body p-4">

                    <h2 class="mb-4">
                        <i class="bi bi-person-plus text-primary"></i>
                        Добавление студента
                    </h2>

                    <form asp-action="Create" method="post">

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label"></label>
                            <input asp-for="FullName" class="form-control" placeholder="Иванов Иван Иванович" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Faculty" class="form-label"></label>
                            <input asp-for="Faculty" class="form-control" placeholder="УИР" />
                            <span asp-validation-for="Faculty" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Course" class="form-label"></label>
                                <input asp-for="Course" class="form-control" type="number" min="1" max="4" />
                                <span asp-validation-for="Course" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="AverageGrade" class="form-label"></label>
                                <input asp-for="AverageGrade" class="form-control" type="number" step="0.1" min="0" max="10" />
                                <span asp-validation-for="AverageGrade" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="IsEnrolled" class="form-check-input" />
                            <label asp-for="IsEnrolled" class="form-check-label"></label>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg"></i> Сохранить
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Назад к списку
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}